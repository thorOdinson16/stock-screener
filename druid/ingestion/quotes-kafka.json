{
  "type": "kafka",
  "dataSchema": {
    "dataSource": "market_quotes",
    "timestampSpec": {
      "column": "timestamp",
      "format": "auto"
    },
    "dimensionsSpec": {
      "dimensions": [
        "symbol",
        "industry",
        "exchange",
        "sector"
      ]
    },
    "metricsSpec": [
      {
        "type": "doubleSum",
        "name": "open",
        "fieldName": "open"
      },
      {
        "type": "doubleSum",
        "name": "high",
        "fieldName": "high"
      },
      {
        "type": "doubleSum",
        "name": "low",
        "fieldName": "low"
      },
      {
        "type": "doubleSum",
        "name": "close",
        "fieldName": "close"
      },
      {
        "type": "longSum",
        "name": "volume",
        "fieldName": "volume"
      },
      {
        "type": "doubleSum",
        "name": "previous_close",
        "fieldName": "previous_close"
      },
      {
        "type": "doubleSum",
        "name": "change_percent",
        "fieldName": "change_percent"
      },
      {
        "type": "doubleSum",
        "name": "market_cap",
        "fieldName": "market_cap"
      }
    ],
    "granularitySpec": {
      "type": "uniform",
      "segmentGranularity": "day",
      "queryGranularity": "none",
      "rollup": false
    }
  },
  "ioConfig": {
    "type": "kafka",
    "inputFormat": {
      "type": "json"
    },
    "consumerProperties": {
      "bootstrap.servers": "localhost:9092"
    },
    "topic": "market.quotes",
    "useEarliestOffset": true,
    "taskCount": 1,
    "replicas": 1,
    "taskDuration": "PT5M",
    "completionTimeout": "PT10M"
  },
  "tuningConfig": {
    "type": "kafka",
    "maxRowsInMemory": 100000,
    "maxRowsPerSegment": 500000,
    "intermediateHandoffPeriod": "PT1M"
  }
}
