      {
        "type": "doubleSum",
        "name": "earnings_growth",
        "fieldName": "earnings_growth"
      },
      {
        "type": "doubleSum",
        "name": "score_5d",
        "fieldName": "score_5d"
      },
      {
        "type": "longSum",
        "name": "rank_5d",
        "fieldName": "rank_5d"
      },
      {
        "type": "doubleSum",
        "name": "score_21d",
        "fieldName": "score_21d"
      },
      {
        "type": "longSum",
        "name": "rank_21d",
        "fieldName": "rank_21d"
      }
    ],
    "granularitySpec": {
      "type": "uniform",
      "segmentGranularity": "day",
      "queryGranularity": "none",
      "rollup": false
    }
  },
  "ioConfig": {
    "type": "kafka",
    "inputFormat": {
      "type": "json"
    },
    "consumerProperties": {
      "bootstrap.servers": "localhost:9092"
    },
    "topic": "market.screener",
    "useEarliestOffset": true,
    "taskCount": 1,
    "replicas": 1,
    "taskDuration": "PT5M",
    "completionTimeout": "PT10M"
  },
  "tuningConfig": {
    "type": "kafka",
    "maxRowsInMemory": 100000,
    "maxRowsPerSegment": 500000,
    "intermediateHandoffPeriod": "PT1M"
  }
}
