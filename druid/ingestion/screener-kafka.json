        "fieldName": "sma_50"
      },
      {
        "type": "doubleSum",
        "name": "sma_200",
        "fieldName": "sma_200"
      },
      {
        "type": "doubleSum",
        "name": "ema_12",
        "fieldName": "ema_12"
