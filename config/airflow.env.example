# Airflow REST API credentials for the dashboard's "Run pipeline" trigger.
# Copy to config/airflow.env (gitignored) and fill in.
#
# Airflow 3 uses the simple_auth_manager in standalone mode; the generated admin
# password lives in ~/airflow/simple_auth_manager_passwords.json.generated.

AIRFLOW_API_URL=http://localhost:8080/api/v2
AIRFLOW_AUTH_URL=http://localhost:8080/auth/token
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=replace-me
