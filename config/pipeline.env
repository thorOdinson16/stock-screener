# Shared environment for the on-demand screening pipeline.
# Sourced by scripts/lib.sh (and therefore every pipeline step / Airflow task).
# Override any value by exporting it before running.

# ---- service homes ---------------------------------------------------------
export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-17-openjdk-amd64}"
export SPARK_HOME="${SPARK_HOME:-/home/abhi/spark}"
export HADOOP_HOME="${HADOOP_HOME:-/home/abhi/hadoop}"
export KAFKA_HOME="${KAFKA_HOME:-/home/abhi/kafka}"
export SEATUNNEL_HOME="${SEATUNNEL_HOME:-/home/abhi/seatunnel}"
export DRUID_HOME="${DRUID_HOME:-/home/abhi/druid}"
export HIVE_HOME="${HIVE_HOME:-/home/abhi/hive}"
export AIRFLOW_HOME="${AIRFLOW_HOME:-/home/abhi/airflow}"

export PATH="$SPARK_HOME/bin:$HADOOP_HOME/bin:$KAFKA_HOME/bin:$SEATUNNEL_HOME/bin:$JAVA_HOME/bin:$PATH"

# ---- pipeline defaults -----------------------------------------------------
export SPARK_MASTER="${SPARK_MASTER:-local[8]}"
export SPARK_DRIVER_MEMORY="${SPARK_DRIVER_MEMORY:-6g}"
export WAREHOUSE="${WAREHOUSE:-hdfs://localhost:9000/warehouse}"
export DRUID_URL="${DRUID_URL:-http://localhost:8888}"
export KAFKA_BOOTSTRAP="${KAFKA_BOOTSTRAP:-localhost:9092}"

# Spark package coordinates
export ICEBERG_PKG="org.apache.iceberg:iceberg-spark-runtime-4.1_2.13:1.11.0"
export KAFKA_PKG="org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.3"

# Scoring / serving
export TOP_K="${TOP_K:-20}"

# Default cap on the polled universe (empty = full NIFTY 500).
export DEFAULT_UNIVERSE_LIMIT="${DEFAULT_UNIVERSE_LIMIT:-}"

# Poller virtualenv interpreter.
export POLLER_PYTHON="${POLLER_PYTHON:-$REPO_ROOT/poller/.venv/bin/python}"

# Iceberg maintenance snapshot retention (see scripts/maintenance.sh).
export SNAPSHOT_RETENTION_DAYS="${SNAPSHOT_RETENTION_DAYS:-7}"
